allowimplicitcalls 1

entry
call main
end

export strlen 999 0
export pushallvars 998 1
export popallvars 997 2
export stripnewline 996 0
export forloop 995 4
export nccalcaddr 994 0


function strlen
	pushtp
	pushi 0
	while
		addstki 1
		next
	endblock
	swap
	poptp
	return


function pushallvars
	set 26
	while
		dec
		pusht
		pushvar
	endblock
	return


function popallvars
	set 26
	while
		next
		pusht
		popvar
		inc
		prev
		dec
	endblock
	return


function stripnewline
	pushtp
	while
		next
	endblock
	prev
	set 0
	poptp
	return


function forloop
	right 2, pop, prev, pop, prev, pop
	forever
		right 2, pusht, next, pop
		left 2, pusht, right 2
		gt, if
			break
		endblock
		left 2, pusht, prev, pusht
		call indirect
		next, inc, prev
	endblock
	return


function nccalcaddr
	mulstki 80
	stkadd
	addstki 14000
	return
