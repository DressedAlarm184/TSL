allowimplicitcalls 1

entry
call main
end

export strlen 999 0
export pushallvars 998 1
export popallvars 997 2
export stripnewline 996 0


function strlen
	pushtp
	pushi 0
	while
		addstk 1
		next
	endblock
	swap
	poptp
	return


function pushallvars
	set 26
	while
		dec
		pusht
		pushvar
	endblock
	return


function popallvars
	set 26
	while
		next
		pusht
		popvar
		inc
		prev
		dec
	endblock
	return


function stripnewline
	pushtp
	while
		next
	endblock
	prev
	set 0
	poptp
	return
